# libabigail suppressions for check-abi.sh, see
# https://sourceware.org/libabigail/manual/libabigail-concepts.html#suppression-specifications
#
# Every entry here hides a class of changes from the ABI check, so keep it
# short and say why each one is safe.

# Enums end with a *_LAST member that is not part of the ABI (it is skipped
# in the GType too). Adding a member before it changes its value, which is
# fine as long as no other member changes.
[suppress_type]
  type_kind = enum
  changed_enumerators_regexp = .*_LAST$

# Only types declared in the public headers are part of the ABI. Checking
# all types (--non-reachable-types, for the class structs) would otherwise
# include the internals of every C and C++ file, eg. template types in
# Highway.
[suppress_type]
  source_location_not_regexp = /include/vips/[^/]+\.h$

# Rust types, which mostly have no source location. The Rust code in
# libvips exports nothing (see libvips/meson.build), so its types are never
# part of the ABI. Rust type names are paths (core::option::Option) or start
# with &, (, [ or *, C type names never do.
[suppress_type]
  file_name_regexp = (^|/)libvips\.so
  name_regexp = (::|^[&(\[*])
